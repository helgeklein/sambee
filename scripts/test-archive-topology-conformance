#!/bin/bash
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
BACKEND_PYTHON="$REPO_ROOT/backend/.venv/bin/python"

if [[ ! -x "$BACKEND_PYTHON" ]]; then
    echo "Backend virtual environment is required at backend/.venv" >&2
    exit 1
fi

cd "$REPO_ROOT/backend"
"$BACKEND_PYTHON" -m pytest -q tests/test_archive_topology_conformance_harness.py

cd "$REPO_ROOT/companion/src-tauri"
cargo test archive_sessions::tests --lib -q
cargo test archive_relay_transport_handles_acknowledgements_and_response_errors --lib -q
cargo test topology_trace_fixture_assigns_mixed_execution_to_companion_relay_coordinators --lib -q
cargo test actual_relay_creation_coordinator_executes_both_mixed_topologies --lib -q
cargo test actual_relay_extraction_coordinator_executes_both_mixed_topologies --lib -q
