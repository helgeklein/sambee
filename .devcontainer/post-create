#!/bin/bash

PIP_AUDIT_VERSION="2.10.0"
CARGO_AUDIT_VERSION="0.22.1"
USER_LOCAL_DIR="/home/vscode/.local"
CARGO_TOOL_ROOT="/home/vscode/.local/cargo-tools"
CARGO_AUDIT_BIN="$CARGO_TOOL_ROOT/bin/cargo-audit"
WINDOWS_GNU_TARGET="x86_64-pc-windows-gnu"

ensure_vscode_owned_directory() {
    local directory="$1"

    sudo mkdir -p "$directory"
    if [ "$(stat -c %U "$directory")" != "vscode" ]; then
        echo "🔧 Fixing ownership for $directory..."
        sudo chown -R vscode:vscode "$directory"
    fi
}

echo "🚀 Setting up Sambee development environment..."

# Setup Git hooks for automatic commit tracking
echo "🔧 Configuring Git hooks..."
git config core.hooksPath .githooks
echo "✓ Git hooks configured"

# Fix cache directory ownership if it exists and is owned by root
if [ -d /home/vscode/.cache ]; then
    echo "🔧 Fixing cache permissions..."
    sudo chown -R vscode:vscode /home/vscode/.cache
fi

echo "🔧 Preparing user-local tools directory..."
sudo mkdir -p "$USER_LOCAL_DIR"
sudo chown vscode:vscode "$USER_LOCAL_DIR"

echo "🔧 Preparing Cargo caches..."
for cargo_directory in \
    /home/vscode/.cargo/registry \
    /home/vscode/.cargo/git \
    /home/vscode/.cargo/advisory-db \
    "$CARGO_TOOL_ROOT"; do
    ensure_vscode_owned_directory "$cargo_directory"
done

# Backend setup
echo "📦 Installing Python dependencies..."
/workspace/scripts/setup-backend-venv

echo "🔍 Installing Python audit tooling..."
if ! /home/vscode/.local/bin/pip-audit --version 2>/dev/null | grep -q "${PIP_AUDIT_VERSION}"; then
    /usr/local/bin/python -m pip install --user "pip-audit==${PIP_AUDIT_VERSION}"
fi

# Create config.toml file if it doesn't exist (MUST happen before database init)
cd /workspace
source /workspace/scripts/ensure-env
ensure_config_file /workspace/config.toml

# Sync version from VERSION file to package.json
echo "🔄 Syncing version..."
/workspace/scripts/sync-version

# Create local data directory
echo "📁 Creating local data directory..."
mkdir -p /workspace/data

# Initialize database (now that config.toml exists)
echo "🗄️ Initializing SQLite database..."
cd /workspace/backend
.venv/bin/python -c "from app.db.database import init_db; init_db()"

# Frontend setup
echo "📦 Installing Node dependencies..."
cd /workspace/frontend

# Fix frontend node_modules ownership if it exists and is owned by root
if [ -d node_modules ] && [ "$(stat -c %U node_modules 2>/dev/null)" = "root" ]; then
    echo "🔧 Fixing node_modules permissions..."
    sudo chown -R vscode:vscode node_modules
    sudo rm -rf node_modules  # Remove to ensure clean install
fi

npm ci

# Verify npm install succeeded
if [ ! -d "node_modules" ] || [ -z "$(ls -A node_modules 2>/dev/null)" ]; then
    echo "⚠️  Warning: npm install may have failed. node_modules is empty."
    echo "   This will be fixed automatically when starting the frontend."
else
    echo "✅ Node dependencies installed successfully"
fi

# Companion app setup (Tauri v2)
if [ -d /workspace/companion ]; then
    echo "📦 Installing companion app dependencies..."
    cd /workspace/companion
    npm ci
    echo "🎯 Installing Windows GNU Rust target..."
    if ! rustup target add "$WINDOWS_GNU_TARGET"; then
        echo "Failed to install the required Rust target: $WINDOWS_GNU_TARGET"
        exit 1
    fi
    echo "🦀 Fetching Rust dependencies..."
    cd src-tauri
    if ! cargo fetch; then
        echo "Failed to fetch companion Rust dependencies."
        exit 1
    fi
    cd ..

    echo "🔍 Installing Rust audit tooling..."
    if ! "$CARGO_AUDIT_BIN" --version 2>/dev/null | grep -Fxq "cargo-audit ${CARGO_AUDIT_VERSION}"; then
        if ! cargo install cargo-audit --root "$CARGO_TOOL_ROOT" --version "${CARGO_AUDIT_VERSION}" --locked --force; then
            echo "Failed to install cargo-audit ${CARGO_AUDIT_VERSION}."
            exit 1
        fi
    fi

    echo "✅ Companion app dependencies installed"
fi

echo "✅ Development environment setup complete!"
echo ""
